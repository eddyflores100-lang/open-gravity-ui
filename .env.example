# Required for Redis persistence, queues and IP-based rate limits.
UPSTASH_REDIS_REST_URL=https://replace-with-your-upstash-endpoint
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token

# Generate independent random values (for example: openssl rand -hex 32).
# These are server-to-server keys; never expose them through NEXT_PUBLIC_*.
OPEN_GRAVITY_ADMIN_KEY=replace_with_a_unique_64_character_secret
OPEN_GRAVITY_DIAG_TOKEN=replace_with_a_different_64_character_secret

# Optional model and research providers.
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=

# Diagnostics only. Keep the token least-privileged and rotate it if exposed.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
